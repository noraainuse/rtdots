{
    "position": "bottom",
    "height": 30,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "group/my-container"
    ],
    "group/my-container": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "network",
            "battery",
            "clock"
        ]
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d}"
    }
}