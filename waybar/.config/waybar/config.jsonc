{
    "position": "top",
    "height": 30,
    "custom/start": {
        "format": " Start",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "modules-left": [
        "custom/start",
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "group/my-container"
    ],
    "group/my-container": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "network",
            "tray",
            "battery",
            "clock"
        ]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\udb83\ude08 Muted",
        "format-icons": {
            "default": [
                "\uf027",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        }
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "network": {
        "interval": 5,
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "Wired",
        "format-disconnected": "󰌙 Disconnected",
        "tray": {
            "icon-size": 21,
            "spacing": 10
        }
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰂎",
            "󱊡",
            "󱊢",
            "󱊣",
            "󱊣"
        ]
    }
}
